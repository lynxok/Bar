{
  "name": "lynx-baros",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint": "tsc --noEmit",
    "test:server": "node tests/server/auth.test.cjs && node tests/server/mercadopago.test.cjs",
    "test:sync": "node tests/integration/run.mjs",
    "test": "vitest run && npm run test:server && npm run test:sync",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "afip.ts": "^3.2.2",
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "fake-indexeddb": "^6.2.5",
    "html5-qrcode": "^2.3.8",
    "jsdom": "^26.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.5",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.lynx.barpos",
    "productName": "LYNX BarOS",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LYNX BarOS"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lynxok",
        "repo": "Bar"
      }
    ]
  },
  "description": "LYNX BarOS - gestión comercial offline-first para bares y restaurantes"
}
